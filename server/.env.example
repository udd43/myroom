# === MyRoom Server Configuration Example ===
# Copy to `server/.env` on your Oracle Cloud VM and fill in the keys you want to activate.

# 1) Security & CORS
# Comma-separated frontend origins allowed by CORS (your Vercel production domain)
MYROOM_CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# Optional regex matching Vercel preview deployments (leave empty to disallow previews)
MYROOM_CORS_ORIGIN_REGEX=^https://[a-zA-Z0-9-]+\.vercel\.app$
# Set a password to lock write/delete/room APIs (leave empty for open demo mode)
MYROOM_ADMIN_PASSWORD=
# Signing secret for Bearer tokens (auto-generated in server/data/.auth_secret if blank)
MYROOM_AUTH_SECRET=

# 2) Resource & OOM Guards (Oracle 1 GB RAM Free Tier friendly)
MYROOM_MAX_UPLOAD_MB=150
MYROOM_MAX_MEDIA_MB=40
MYROOM_MAX_CONCURRENT_JOBS=1

# 3) Optional Cloudflare R2 Object Storage (0 egress fee, 10 GB free/mo)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# 4) Korean Real Estate & Location APIs (Optional — degrades gracefully when empty)
# 공공데이터포털 (data.go.kr): 건축물대장(getBrTitleInfo) + 전월세 실거래가
DATA_GO_KR_API_KEY=
# 행안부 도로명주소 (business.juso.go.kr)
JUSO_API_KEY=
# 카카오 Developers (developers.kakao.com): Kakao Local 좌표/역/편의점
KAKAO_REST_API_KEY=
KAKAO_MOBILITY_TRANSIT_ENABLED=false
# ODsay LAB 대중교통 길찾기 (lab.odsay.com - 무료 Basic 1,000건/일)
ODSAY_API_KEY=
# 국토교통부 브이월드 (vworld.kr): 주변 건물 3D 높이/폴리곤 (LT_C_SPBD)
VWORLD_API_KEY=
VWORLD_DOMAIN=myroom-api-jj.duckdns.org
